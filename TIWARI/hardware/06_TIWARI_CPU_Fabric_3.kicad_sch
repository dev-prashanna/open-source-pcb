font (size 1 1))) (hide yes)) (instances (project "TIWARI" (path "/217081e8-874e-484a-a0a7-cc0550683dad/63379c11-fd04-4e6d-9543-29d7d46aa23c" (reference "U1") (unit 4)))) (pin "5" (uuid "82252ed9-2a44-4822-96d6-80b9d4ee4f1a")) (pin "24" (uuid "21a59eb2-a0ee-487d-b995-df486229dbc8")) (pin "29" (uuid "27dc7291-1791-4186-9551-c241f7695084")) (pin "30" (uuid "bbd5e9be-1685-4f28-a5f0-da086a8097ea")) (pin "49" (uuid "74c0aa9b-a861-44dd-87ea-7fadee5e84ee"))) (text "Original TIWARI-8 processor in FPGA; 8-bit A/B datapath and 12-bit instruction PC.\n12MHz external oscillator -> FPGA PLL -> 36MHz CPU target. GPIO is 3.3V only.\nSPI_SO outputs MOSI to flash DI; SPI_SI receives flash DO. CS and CRESET are open-drain from FTDI.\nU1 exposed paddle and every ground via require reliable plane contact. NVCM programming is not supported." (at 20.32 266.7 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "ea3e97cc-232a-4420-9795-035e7b3b9fc2")) (embedded_fonts no))
