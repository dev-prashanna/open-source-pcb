(instances (project "TIWARI" (path "/217081e8-874e-484a-a0a7-cc0550683dad/ba79588f-0797-42a0-bd8e-b14f5132742d" (reference "D3") (unit 1)))) (pin "1" (uuid "2d52344d-31cf-49fe-a159-a8473fd9de69")) (pin "2" (uuid "1aeb9b2c-6f94-4a03-bd30-d9dd6f76a6a2"))) (text "J2: GND,3V3,D0..D7. J3: GND,3V3,D8..D15. J4: GND,PWM0,PWM1,3V3.\nJ5 is a rear service header; do not attach a second SPI host while USB programmer is active.\nGPIO reset state is high impedance. No analog ADC or Arduino shield pin compatibility is provided.\nUse a common ground with external circuits; 3.3V rail on headers is output only." (at 20.32 266.7 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "d0fbb21a-d316-43e1-b997-e30ab449a24f")) (embedded_fonts no))
